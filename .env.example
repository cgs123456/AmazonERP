# ============================================================
# Amazon ERP — 环境变量配置模板
# 复制为 .env 并填入真实凭据
# ============================================================

# --- 数据库 ---
DB_USERNAME=root
DB_PASSWORD=<your-mysql-password>
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Redis ---
REDIS_PASSWORD=<your-redis-password>
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=<your-rabbitmq-password>
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
MQ_PASSWORD=<your-rabbitmq-password>

# --- MongoDB ---
MONGO_PASSWORD=<your-mongo-password>

# --- JWT ---
JWT_SECRET_KEY=<generate-a-strong-256-bit-key>

# --- AI / LLM ---
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# --- AWS SP-API ---
AWS_ACCESS_KEY=<your-aws-access-key>
AWS_SECRET_KEY=<your-aws-secret-key>
AWS_REGION=us-east-1

# --- Encryption ---
AMZ_CRYPTO_KEY=<generate-a-base64-encoded-32-byte-key>

# --- Third-party APIs ---
KEEPA_API_KEY=<your-keepa-api-key>

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=<your-grafana-password>

# --- Feature flags ---
SEATA_ENABLED=false
SSL_ENABLED=false
