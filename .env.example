# ============================================================
# Amazon ERP — 环境变量配置模板
# 复制为 .env 并填入真实凭据
# ============================================================

# --- 数据库 ---
DB_USERNAME=root
DB_PASSWORD=<your-mysql-password>
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Redis ---
REDIS_PASSWORD=<your-redis-password>
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=<your-rabbitmq-password>
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
MQ_USERNAME=admin
MQ_PASSWORD=<your-rabbitmq-password>

# --- MongoDB ---
MONGO_USERNAME=root
MONGO_PASSWORD=<your-mongo-password>

# --- JWT ---
JWT_SECRET_KEY=<generate-a-strong-256-bit-key>
JWT_ISSUER=amz-erp
JWT_AUDIENCE=amz-erp-client

# --- AI / LLM ---
DEEPSEEK_API_KEY=<your-deepseek-api-key>
# Agent LLM 评估总开关（POST /ai/eval/run?mode=both 需同时开启）
AGENT_LLM_EVAL_ENABLED=false

# --- IM 推送（主动提醒 B-3：企微/飞书群机器人 webhook，不配则静默跳过） ---
IM_WEBHOOK_URL=
# 可选值：feishu / wecom / generic（默认 generic，原样透传 {"text": ...}）
IM_WEBHOOK_KIND=generic

# --- 店铺知识库 B-1（ES 混合检索；本地默认直连 localhost:9200） ---
KNOWLEDGE_ES_BASE_URL=http://localhost:9200
KNOWLEDGE_ES_INDEX=amz_knowledge_base
KNOWLEDGE_ES_VECTOR_DIMS=1536

# --- AWS SP-API ---
AWS_ACCESS_KEY=<your-aws-access-key>
AWS_SECRET_KEY=<your-aws-secret-key>
AWS_REGION=us-east-1

# --- Encryption ---
AMZ_CRYPTO_KEY=<generate-a-base64-encoded-32-byte-key>

# --- Third-party APIs ---
KEEPA_API_KEY=<your-keepa-api-key>

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=<your-grafana-password>

# --- Feature flags ---
SEATA_ENABLED=false
SSL_ENABLED=false
# Swagger/OpenAPI 文档端点是否放行鉴权：true(默认)/false，生产环境建议 false
GATEWAY_DOCS_ENABLED=true
# 订单同步后凭证生成走 MQ（B1，默认 true；false 回退同步 Feign）。
# Spring Boot 宽松绑定自动映射到 finance.voucher.async，无需改 application.yml。
FINANCE_VOUCHER_ASYNC=true
