# ============================================================
# Amazon ERP 环境变量模板
#
# 生产：复制为 .env，替换全部 CHANGE_ME_*，并显式保留 SPRING_PROFILES_ACTIVE=prod。
# 演示：使用 .env.demo.example，严禁用于生产或验收。
# 注意：仓库只保存占位符，真实密钥必须通过 K8s Secret / Vault / KMS 等外部系统注入。
# ============================================================

# --- 运行模式与 JVM ---
# 生产必须 prod；无凭证离线演示只能显式使用 mock
SPRING_PROFILES_ACTIVE=mock
TZ=Asia/Shanghai
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
# K8s gateway 使用；Compose gateway 使用 JAVA_OPTS
JAVA_OPTS_GATEWAY=-Xms256m -Xmx512m -XX:+UseG1GC
# 生产默认关闭网关 API 文档；仅本地或受控内网显式改为 true
GATEWAY_DOCS_ENABLED=false

# --- 基础设施 ---
NACOS_ADDR=nacos:8848
MYSQL_HOST=mysql
MYSQL_SLAVE_HOST=mysql-slave
MYSQL_PORT=3306
DB_USERNAME=root
# 生产必须替换；Compose 缺失时直接拒绝解析
DB_PASSWORD=amz-demo-db-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=amz-demo-redis-password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=amz-demo-rabbitmq-password
MONGO_HOST=mongodb
MONGO_USERNAME=root
MONGO_PASSWORD=amz-demo-mongo-password
GRAFANA_USER=admin
GRAFANA_PASSWORD=amz-demo-grafana-password
SENTINEL_DASHBOARD=sentinel-dashboard:8858

# --- 安全密钥 ---
# 生产使用至少 32 字节随机值
JWT_SECRET_KEY=amz-erp-demo-only-jwt-secret-0123456789abcdef
JWT_ISSUER=amz-erp
JWT_AUDIENCE=amz-erp-client
# 生产执行 openssl rand -base64 32；必须解码为 32 字节
AMZ_CRYPTO_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Amazon SP-API ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
# 生产必须为空；非生产仅用于本地桩/回放
SPAPI_BASE_URL_OVERRIDE=
# 生产必须为空
SPAPI_LWA_ENDPOINT_OVERRIDE=
# 仅非生产端点覆盖时使用
SPAPI_ALLOWLIST=
SPAPI_APP_NAME=AmazonERP
SPAPI_APP_VERSION=1.0.0
SPAPI_LANGUAGE=zh_CN
SPAPI_PLATFORM=Linux
SPAPI_USER_AGENT="AmazonERP/1.0.0 (Language=zh_CN; Platform=Linux)"
# 生产缺店铺凭证即拒绝启动；mock 演示才可关闭
SPAPI_REQUIRE_CREDENTIALS=false
# 生产凭证库异常必须拒绝启动/拒绝伪降级；mock 演示才可关闭
SPAPI_CREDENTIAL_STORE_FAIL_ON_DB_ERROR=false
# 凭证按店铺懒加载；缓存只保存密文，并限制容量与有效期
SPAPI_CREDENTIAL_CACHE_MAX_ENTRIES=1000
SPAPI_CREDENTIAL_CACHE_TTL_SECONDS=600
# 活跃店铺 ID 快照 TTL；用于减少调度器重复扫描，不缓存凭证明文
SPAPI_ACTIVE_SHOP_IDS_TTL_SECONDS=60
# 演示环境不申请真实 RDT；完成授权和沙箱验收后由生产模板显式开启
SPAPI_RESTRICTED_DATA_ENABLED=false
SPAPI_RESTRICTED_DATA_REFRESH_SKEW_SECONDS=60
SPAPI_RESTRICTED_DATA_MAX_CACHE_ENTRIES=1000
# 演示环境不使用真实订单 PII
SPAPI_ORDER_PII_SYNC_ENABLED=false
# 无真实凭据的演示环境不启动后台重放，避免把 mock 行为写入持久化账本
SPAPI_OUTBOX_SCHEDULER_ENABLED=false
SPAPI_OUTBOX_SCHEDULER_DELAY_MS=60000
SPAPI_OUTBOX_BATCH_SIZE=50
SPAPI_OUTBOX_MAX_ATTEMPTS=4
SPAPI_OUTBOX_BASE_DELAY_SECONDS=60
SPAPI_OUTBOX_REPLAY_CLAIM_TIMEOUT_SECONDS=900
# SP-API 通知入站：演示模板同样默认关闭；需演练时设 ENABLED=true 且 SOURCE=mock（profile 不得为 prod）
SPAPI_NOTIFICATIONS_ENABLED=false
SPAPI_NOTIFICATIONS_SOURCE=mock
SPAPI_NOTIFICATIONS_QUEUE_URL=
SPAPI_NOTIFICATIONS_REGION=
SPAPI_NOTIFICATIONS_STS_ROLE_ARN=
SPAPI_NOTIFICATIONS_WAIT_TIME_SECONDS=20
SPAPI_NOTIFICATIONS_MAX_MESSAGES=10
SPAPI_NOTIFICATIONS_VISIBILITY_TIMEOUT_SECONDS=60
SPAPI_NOTIFICATIONS_BATCH_SIZE=10
SPAPI_NOTIFICATIONS_MAX_ATTEMPTS=5
SPAPI_NOTIFICATIONS_BASE_DELAY_SECONDS=30
SPAPI_NOTIFICATIONS_LEASE_TIMEOUT_SECONDS=300
SPAPI_NOTIFICATIONS_PAYLOAD_MAX_BYTES=262144
SPAPI_NOTIFICATIONS_SUBSCRIPTION_SYNC_ENABLED=true
SPAPI_NOTIFICATIONS_MOCK_SCENARIO=order-change
# 首次 bootstrap 专用：宿主机凭证 JSON 的路径；不得提交真实文件
SPAPI_BOOTSTRAP_CREDENTIAL_FILE_HOST=

# --- AI 与向量检索 ---
# 填入真实 Key 后翻译能力立即可用
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TIMEOUT_SECONDS=60
# 有 embedding API 时改为 true
EMBEDDING_ENABLED=false
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
AGENT_AI_CHAT_URL=http://amz-gateway:10010/ai/agent/chat
ES_URIS=http://elasticsearch:9200
KNOWLEDGE_ES_BASE_URL=http://elasticsearch:9200
KNOWLEDGE_ES_INDEX=amz_knowledge_base
KNOWLEDGE_ES_VECTOR_DIMS=1536

# --- 物流与 17TRACK ---
# 有 17TRACK Key 时改为 true
AMZ_TRACKING_ENABLED=false
AMZ_17TRACK_BASE_URL=https://api.17track.net
AMZ_TRACKING_MAX_EXISTING_EVENTS=10000
AMZ_17TRACK_KEY=
AMZ_LOGISTICS_SYNC_INTERVAL_MS=1800000
AMZ_LOGISTICS_SYNC_LEASE_SECONDS=1680
AMZ_LOGISTICS_SYNC_MAX_PER_ROUND=200
AMZ_LOGISTICS_DELAY_CRON=0 0 1 * * ?
AMZ_LOGISTICS_DELAY_LEASE_SECONDS=1800
AMZ_LOGISTICS_DELAY_GRACE_DAYS=0
AMZ_LOGISTICS_DELAY_BATCH_SIZE=500
AMZ_LOGISTICS_DELAY_MAX_SCAN=50000
AMZ_LOGISTICS_STALE_HOURS=48
AMZ_LOGISTICS_TRANSIT_WINDOW_DAYS=90
AMZ_LOGISTICS_TRANSFER_STALE_DAYS=7
AMZ_LOGISTICS_TRANSFER_APPROVAL_STALE_DAYS=3
AMZ_LOGISTICS_DASHBOARD_AGGREGATION_SCAN_LIMIT=10000

# --- 采购、财务与对象存储 ---
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_REFRESH_TOKEN=
KINGDEE_API_GATEWAY=
KINGDEE_DB_ID=
KINGDEE_USER_NAME=
KINGDEE_APP_ID=
KINGDEE_APP_SECRET=
KINGDEE_LCID=2052
KINGDEE_ACCOUNT_BOOK_NUMBER=
KINGDEE_VOUCHER_GROUP_NUMBER=
KINGDEE_CURRENCY_NUMBER=
KINGDEE_EXCHANGE_RATE_TYPE_NUMBER=
KINGDEE_SYNC_LEASE_SECONDS=300
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
KEEPA_API_KEY=
LISTING_COPY_POLL_ENABLED=true
LISTING_COPY_POLL_SCHEDULER_DELAY_MS=15000
LISTING_COPY_POLL_INITIAL_DELAY_SECONDS=15
LISTING_COPY_POLL_INTERVAL_SECONDS=15
LISTING_COPY_POLL_MAX_DURATION_SECONDS=300
LISTING_COPY_POLL_BATCH_SIZE=20
# Amazon Advertising API：mock 模式不使用；切到真实 API 时填写完整凭证
AD_API_ENDPOINT=https://advertising-api.amazon.com
AD_TOKEN_ENDPOINT=https://api.amazon.com/auth/o2/token
AD_SHOP_ID=
AD_CLIENT_ID=
AD_CLIENT_SECRET=
AD_REFRESH_TOKEN=
AD_PROFILE_ID=
