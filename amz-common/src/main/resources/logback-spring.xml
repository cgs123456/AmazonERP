<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 引入 Spring Boot 默认日志配置（日志级别、彩色控制台等） -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- ==================== 控制台输出（保留默认行为） ==================== -->
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- ==================== 操作日志独立文件 appender ==================== -->
    <!-- 通过 logger name="oper-log" 路由，仅写入 oper-log.log，不污染业务日志 -->
    <appender name="oper-log" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/oper-log.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 按天滚动 + 单文件 100MB 上限，保留 30 天 -->
            <fileNamePattern>logs/oper-log.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- oper-log logger：additivity=false 阻止向 root 冒泡，避免重复打印到控制台 -->
    <logger name="oper-log" level="INFO" additivity="false">
        <appender-ref ref="oper-log"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
