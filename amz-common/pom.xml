<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.amz</groupId>
        <artifactId>AmzErp</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>amz-common</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- AOP：支持 OperLogAspect 切面拦截 @OperLog 注解方法 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Actuator：提供 /actuator/health/{liveness,readiness} 探针端点。
             k8s/services/*.yaml 中全部 Deployment 的 readinessProbe / livenessProbe
             均指向该路径，缺失该依赖会导致探针恒返回 404、Pod 永远 NotReady。
             网关（webflux）与业务服务（servlet）共用，由各自 starter 自动适配。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenFeign：供 FeignAuthRelayConfig 编译使用（透传 token/shopId 请求头）。
             optional 避免强制传递给不使用 Feign 的模块（如网关）；
             运行时由引用方自身声明的 spring-cloud-starter-openfeign 提供，
             未声明时 FeignAuthRelayConfig 由 @ConditionalOnClass 自动跳过。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
        </dependency>

        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- MyBatis 核心：供 CryptoTypeHandler 编译使用；optional 避免强制传递给所有依赖 amz-common 的模块，
             运行时由引用方的 mybatis-plus-spring-boot3-starter 传递提供。 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Data Redis：供 FieldPermissionService 缓存字段权限规则；optional，
             运行时由引用方（order/procurement/finance/user 等服务）的 spring-boot-starter-data-redis 提供。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring JDBC：供 FieldPermissionService 启动时从 DB 加载权限规则；optional，
             运行时由引用方的 mybatis-plus-spring-boot3-starter 传递提供。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Seata 分布式事务（AT 模式）—— 所有微服务通过 amz-common 继承该依赖 -->
        <dependency>
            <groupId>io.seata</groupId>
            <artifactId>seata-spring-boot-starter</artifactId>
        </dependency>

        <!-- 测试依赖（JUnit 5 + Mockito + Spring Test），供 FieldPermissionAspect 等纯单元测试使用 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- OpenAPI 3.0 / Swagger UI 文档（所有 MVC 微服务通过 amz-common 继承）。
             optional 避免将 webmvc-ui 传递给非 Servlet 模块（如网关使用 webflux-ui），
             运行时由各 MVC 微服务自身显式声明版本。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>