<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.amz</groupId>
        <artifactId>amz-service</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>amz-service-spapi</artifactId>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- alimaven 鏃?Nexus2 URL 鍙兘缂哄皯閮ㄥ垎杈冩柊鐨?artifact锛堝 onnxruntime锛夛紝
         姝ゅ浠ヤ笉鍚?ID 澹版槑闃块噷浜?Nexus3 浠撳簱浣滀负鍏滃簳銆?         settings.xml 涓?mirrorOf=central 涓嶄細鎷︽埅姝や粨搴撱€?-->
    <repositories>
        <repository>
            <id>aliyun-nexus3</id>
            <name>Aliyun Nexus3 Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- Sentinel锛氱啍鏂檺娴侊紝瑙勫垯鎸佷箙鍖栧埌 Nacos -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Sentinel Nacos 数据源：application.yml 引用 ds1.nacos 规则推送，缺失该依赖启动即崩 -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
            <version>${sentinel.version}</version>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- 鍔ㄦ€佹暟鎹簮锛堣鍐欏垎绂伙級锛歮aster 鍐?/ slave 璇伙紝閰嶅悎 @DS 娉ㄨВ璺敱 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Flyway 数据库迁移 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- RabbitMQ锛歴papi 鎷夊彇璁㈠崟鍚庡彂閫佸埌 order 鏈嶅姟鐨?save/profit 浜ゆ崲鏈?-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- ONNX Runtime锛氱敤浜庡姞杞?LightGBM 瀵煎嚭鐨?ONNX 妯″瀷杩涜 ML 鎺ㄧ悊 -->
        <!-- 娉細浠诲姟瑕佹眰 1.18.2锛屼絾璇ョ増鏈湭鍙戝竷鍒?Maven Central锛屼娇鐢ㄥ悓绯诲垪鏈€杩戝彲鐢ㄧ増鏈?1.18.0 -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.18.0</version>
        </dependency>

        <dependency>
            <groupId>com.amz</groupId>
            <artifactId>amz-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Redisson：调度任务分布式锁，防止多实例部署时定时任务双跑（重复消耗 SP-API 配额） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 娴嬭瘯渚濊禆锛圝Unit 5 + Mockito + Spring Test锛?-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.amz.AmzServiceSpapiApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
