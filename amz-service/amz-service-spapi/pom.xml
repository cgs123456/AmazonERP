<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.amz</groupId>
        <artifactId>amz-service</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>amz-service-spapi</artifactId>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- alimaven 鏃?Nexus2 URL 鍙兘缂哄皯閮ㄥ垎杈冩柊鐨?artifact锛堝 onnxruntime锛夛紝
         姝ゅ浠ヤ笉鍚?ID 澹版槑闃块噷浜?Nexus3 浠撳簱浣滀负鍏滃簳銆?         settings.xml 涓?mirrorOf=central 涓嶄細鎷︽埅姝や粨搴撱€?-->
    <repositories>
        <repository>
            <id>aliyun-nexus3</id>
            <name>Aliyun Nexus3 Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- Sentinel锛氱啍鏂檺娴侊紝瑙勫垯鎸佷箙鍖栧埌 Nacos -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Sentinel Nacos 数据源：application.yml 引用 ds1.nacos 规则推送，缺失该依赖启动即崩 -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
            <version>${sentinel.version}</version>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- 鍔ㄦ€佹暟鎹簮锛堣鍐欏垎绂伙級锛歮aster 鍐?/ slave 璇伙紝閰嶅悎 @DS 娉ㄨВ璺敱 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Flyway 数据库迁移 -->
        <!-- Boot 4 起 Flyway 自动装配拆分到 spring-boot-flyway 模块，必须用 starter 引入；
             flyway-core 裸依赖会让自动装配静默失效（带数据源启动不迁移，本地容器实测）。
            -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- RabbitMQ锛歴papi 鎷夊彇璁㈠崟鍚庡彂閫佸埌 order 鏈嶅姟鐨?save/profit 浜ゆ崲鏈?-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- ONNX Runtime锛氱敤浜庡姞杞?LightGBM 瀵煎嚭鐨?ONNX 妯″瀷杩涜 ML 鎺ㄧ悊 -->
        <!-- 娉細浠诲姟瑕佹眰 1.18.2锛屼絾璇ョ増鏈湭鍙戝竷鍒?Maven Central锛屼娇鐢ㄥ悓绯诲垪鏈€杩戝彲鐢ㄧ増鏈?1.18.0 -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.18.0</version>
        </dependency>

        <dependency>
            <groupId>com.amz</groupId>
            <artifactId>amz-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- ====== SP-API 通知入站（SQS）====== -->
        <!-- 版本由根 pom 的 software.amazon.awssdk:bom 统一管理，此处不写 version。
             只用 sqs（同步客户端）与 auth（凭证链 / STS AssumeRole）。
             硬规则：SQS 消费必须使用独立 IAM 角色，禁止使用店铺静态 AWS 密钥
             （amz_shop_credential.access_key_encrypted / secret_key_encrypted），
             启用该用法会被 NotificationStartupCheck 拒绝启动。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <!-- sts：显式配置 spapi.notifications.sts-role-arn 时通过 STS AssumeRole 取临时凭证。
             未配置该 ARN 时不会创建任何 STS 客户端，回退 AWS 默认凭证链（IRSA / 实例角色）。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>

        <!-- 娴嬭瘯渚濊禆锛圝Unit 5 + Mockito + Spring Test锛?-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.amz.AmzServiceSpapiApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
