<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
    </parent>

    <groupId>com.amz</groupId>
    <artifactId>AmzErp</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <modules>
        <module>amz-common</module>
        <module>amz-gateway</module>
        <module>amz-service</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springboot.version>4.0.8</springboot.version>
        <!-- Boot 4.0.8 BOM 自带 Spring Framework 7.0.9；不要再对 Boot 3.5.x 手工叠加 7.x。 -->
        <junit-jupiter.version>6.0.3</junit-jupiter.version>
        <springcloud.version>2025.1.3</springcloud.version>
        <springcloud-alibaba.version>2025.1.0.0</springcloud-alibaba.version>
        <!-- 3.5.15 起官方支持 Spring Boot 4.0.0（旧版调用已在 Boot 4 删除的
             PropertyMapper.alwaysApplyingWhenNonNull()，带数据源启动必崩，本地容器实测） -->
        <mybatis.version>3.5.17</mybatis.version>
        <mybatis-core.version>3.5.16</mybatis-core.version>
        <!-- netty-all 供 amz-common/amz-service-message 直接引用；版本必须跟随 Boot 4 BOM 的
             netty.version（4.2.x）。Boot 3 时代的 4.1.x 覆盖会让 Reactor Netty 找不到
             MultiThreadIoEventLoopGroup，gateway 起不来（run 37810255053 实测）。
             Boot BOM 不托管 netty-all，只能手动对齐。 -->
        <netty.version>4.2.17.Final</netty.version>
        <lombok.version>1.18.34</lombok.version>
        <lang3.version>3.14.0</lang3.version>
        <!-- amqp-client 是 Boot 4.0.8 BOM 仍低于 CVE 修复线的显式覆盖；
             Tomcat 已由 Boot 4 BOM 升到 11.0.24，不能再沿用 Boot 3 的 10.1.x 覆盖。 -->
        <rabbit-amqp-client.version>5.36.0</rabbit-amqp-client.version>
        <gson.version>2.11.0</gson.version>
        <jwt.version>4.4.0</jwt.version>
        <oss.version>3.17.4</oss.version>
        <elasticsearch.version>8.15.3</elasticsearch.version>
        <redisson.version>3.37.0</redisson.version>
        <langchain4j.version>1.20.2</langchain4j.version>
        <onnxruntime.version>1.18.2</onnxruntime.version>
        <sentinel.version>1.8.9</sentinel.version>
        <seata.version>2.0.0</seata.version>
        <!-- 动态数据源（读写分离）：4.5.0 起官方支持 Spring Boot 4.0.0（#738）；
             4.3.1 在带数据源启动时会走到 MyBatis-Plus 旧自动装配而崩。 -->
        <dynamic-datasource.version>4.5.0</dynamic-datasource.version>
        <springdoc.version>2.8.17</springdoc.version>
        <!-- AWS SDK v2：SP-API 通知入站（SQS）。固定版本，禁止动态版本或版本区间。
             注意（实测结论，别再写回上一版注释里的「不会抢版本」）：
             software.amazon.awssdk:bom 只管理 software.amazon.awssdk 组，
             但 apache5-client 依赖的 org.apache.httpcomponents 并不在该 BOM 范围内，
             于是被 spring-boot-dependencies（Spring Boot 3.3.5）接管并降级：
                 httpclient5 5.6.4 -> 5.3.1，httpcore5 5.4.3 -> 5.2.5
             apache5-client 2.55.6 构建同步客户端时会引用
             org.apache.hc.client5.http.ssl.TlsSocketStrategy（httpclient5 5.4+ 才有），
             降级结果是 NoClassDefFoundError —— 它是 Error 不是 Exception，业务 catch 兜不住，
             且 SqsNotificationEventSource 在构造函数里建客户端，SQS 模式下服务启动即失败。
             下面两个版本必须显式钉住，且必须不低于 AWS SDK 实际需要的取值。
             回归保护：amz-service-spapi 的 AwsSdkHttpLinkageContractTest。 -->
        <aws.sdk.version>2.55.6</aws.sdk.version>
        <httpclient5.version>5.6.4</httpclient5.version>
        <httpcore5.version>5.4.3</httpcore5.version>
        <!-- Jackson 2.x：Boot 4 默认 JSON 走 Jackson 3，工程代码仍依赖 Jackson 2；
             Boot 4 BOM 的 Jackson 2 线为 2.21.5，落在 GHSA-q4xh-88c3-wmh7 修复区间前；
             这里覆盖 jackson-2-bom.version 到 2.21.7。 -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- Jackson 3（tools.jackson，Boot 4 默认 JSON 线）：Boot 4.0.8 BOM 自带 3.1.5，
             落在 5 个 HIGH（GHSA-7hhh/cxp5/p6pp/q4xh/wv8q）修复区间内；官方修复版 3.1.7。 -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <!-- Tomcat 覆盖：Boot 4.0.8 BOM 自带 11.0.24，落在 3 个 CRITICAL
             （GHSA-9xv2/gcx9/h3x4，注册/授权类）修复区间内；官方修复版 11.0.25。 -->
        <tomcat.version>11.0.25</tomcat.version>
        <!-- Tika parses PDF/HTML via jsoup; pin the patched 1.23.2 release to clear CVE gate. -->
        <jsoup.version>1.23.2</jsoup.version>
        <!-- BouncyCastle 不在 spring-boot-dependencies 中管理，需显式钉住；1.85 为 Grype 修复线。 -->
        <bouncycastle.version>1.85</bouncycastle.version>
        <!-- Seata 2.0.0 传递引入 com.alibaba:fastjson:1.2.83（Critical RCE，1.x 无修复版本）。
             2.0.65 是官方 v1 兼容包（同 groupId/artifactId，包名仍为 com.alibaba.fastjson），
             用它顶掉 1.x 即消除该 CVE，无需改代码。 -->
        <fastjson.version>2.0.65</fastjson.version>
        <!-- 阿里云 OSS SDK 传递引入 aliyun-java-sdk-core 4.5.10 -> org.ini4j:ini4j:0.5.4
             （High，无修复版本）。core 4.7.10 已移除 ini4j 依赖。 -->
        <aliyun.sdk.core.version>4.7.10</aliyun.sdk.core.version>
        <!-- SkyWalking Java Agent toolkit (与 Dockerfile agent 9.7.0 对齐) -->
        <skywalking.version>9.7.0</skywalking.version>
        <!-- logstash-logback-encoder 8.0 兼容 Logback 1.5.x / Boot 3.5，用于 log-json 结构化输出 -->
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>
    </properties>

    <build>
        <plugins>
            <!-- JDK 21 下 Lombok 注解处理器需显式声明到 annotationProcessorPaths，
                 否则 maven-compiler-plugin 不会触发 Lombok 代码生成。 -->
            <!-- 仓库约定（2026-09-28）：*IT.java 也在 test 阶段执行，本仓不引入 failsafe。
                 前提：IT 必须自带环境守卫（@EnabledIfEnvironmentVariable 等），
                 否则在没有 MySQL/Redis 的开发机上会红。
                 背景：AdMigrationMySqlIT 是全仓唯一的真机 MySQL 8 集成测试，
                 在此之前 surefire 默认不收 *IT.java，它从未在 CI 中执行过，
                 于是里面的缺陷（列/值错位、唯一键断言写错）一直没人发现。
                 注意：CI 不得改用 -Dtest=AdMigrationMySqlIT 来触发，
                 CiWorkflowContractTest 把 -Dtest= 视为「收窄范围」并直接判红。 -->
            <!-- 让 maven-dependency-plugin:properties 暴露 mockito-core 的本地路径，
                 供 surefire 的 -javaagent 使用；否则 Mockito 5 的 inline mock maker 走
                 自附加（self-attach），JDK 会在未来版本禁止。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>expose-test-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${springcloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${springcloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <!-- 3.5.9 起分页拦截器拆到独立构件：order 的 MybatisPlusConfig 需要 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis.version}</version>
            </dependency>

            <!-- MyBatis 核心（供 amz-common 中 TypeHandler 编译使用，运行时由 mybatis-plus 传递提供） -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis-core.version}</version>
            </dependency>

            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>

            <!-- 见 properties 注释：Tika 传递 jsoup，钉住修复版过 CVE gate -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>

            <!-- 见 properties 注释：消除 Seata 传递的 fastjson 1.2.83（Critical） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>${fastjson.version}</version>
            </dependency>

            <!-- 见 properties 注释：消除 OSS SDK 传递的 ini4j 0.5.4（High，无修复） -->
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>aliyun-java-sdk-core</artifactId>
                <version>${aliyun.sdk.core.version}</version>
            </dependency>

            <!-- BouncyCastle 不在 spring-boot-dependencies 中管理，需显式钉住 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${lang3.version}</version>
            </dependency>

            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>

            <dependency>
                <groupId>com.auth0</groupId>
                <artifactId>java-jwt</artifactId>
                <version>${jwt.version}</version>
            </dependency>

            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${oss.version}</version>
            </dependency>

            <!-- LangChain4j（Agent 编排框架） -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-open-ai</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>

            <!-- ONNX Runtime（LightGBM 模型推理） -->
            <dependency>
                <groupId>com.microsoft.onnxruntime</groupId>
                <artifactId>onnxruntime</artifactId>
                <version>${onnxruntime.version}</version>
            </dependency>

            <!-- Sentinel 熔断限流（核心库版本固定 1.8.6） -->
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-core</artifactId>
                <version>${sentinel.version}</version>
            </dependency>

            <!-- Seata 分布式事务（AT 模式） -->
            <dependency>
                <groupId>io.seata</groupId>
                <artifactId>seata-spring-boot-starter</artifactId>
                <version>${seata.version}</version>
            </dependency>

            <!-- 动态数据源（读写分离）：与 MyBatis-Plus 3.5.17 + Spring Boot 4.x 兼容。
                 用法：在 Service/Mapper 方法或类上加 @DS("slave") 即可路由到从库；
                 不加注解默认走 master。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>

            <!-- Flyway 版本交给 Boot 4 BOM（11.14.1）。此前钉死的 10.20.0 是 Boot 3 遗留，
                 会让 Boot 4 的 Flyway 自动装配静默失效（无任何日志、空库不迁移，本地容器实测）。
                 spapi 直接声明 flyway-core/flyway-mysql 无需写 version。
 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- AWS SDK v2 BOM：只管理 software.amazon.awssdk 组；sqs/auth 依赖不写 version。 -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Apache HttpClient 5：AWS SDK 同步客户端（apache5-client）的运行期依赖。
                 这两个 artifact 不在 software.amazon.awssdk:bom 管理范围内，会被
                 spring-boot-dependencies 降级到 SDK 用不了的版本（见上面 aws.sdk.version 注释）。
                 本 pom 直接声明的 dependencyManagement 条目优先于父 pom 及被 import 的 BOM，
                 因此这里钉住的版本一定生效。
                 升级 Spring Boot 或 AWS SDK 后，必须重跑 AwsSdkHttpLinkageContractTest。 -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpclient5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>

            <!-- SkyWalking logback toolkit：%traceId 转换器（对接 Dockerfile 里的 -javaagent）。
                 无 agent 时 TraceContext.traceId() 返回 IGNORED，不会抛异常。 -->
            <dependency>
                <groupId>org.apache.skywalking</groupId>
                <artifactId>apm-toolkit-logback-1.x</artifactId>
                <version>${skywalking.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>